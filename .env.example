# LLM Provider API keys. Leave blank to rely on user-supplied keys (stored in browser localStorage).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional default models per provider.
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Optional base URLs (useful for self-hosted gateways).
OPENAI_BASE_URL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# SQLite database file path (default: data/app.db)
DATABASE_PATH=data/app.db
