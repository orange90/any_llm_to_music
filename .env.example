# ─────────────────────────────────────────────────────────────────────────────
# Default (official) LLM endpoint
#
# This is the "out-of-the-box" AI used when the user hasn't configured any
# personal endpoint in Settings. It uses an OpenAI-compatible chat API.
#
# Daily quota: shared across all visitors of this server. When exceeded, the
# UI shows: "官方提供的AI接口额度不足，可自行接入API".
# Note: the daily quota is only enforced when Redis credentials are present
# (see below). Without Redis (e.g. plain local dev) the default endpoint is
# unmetered.
# ─────────────────────────────────────────────────────────────────────────────
DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_DAILY_LIMIT=100

# ─────────────────────────────────────────────────────────────────────────────
# Daily-quota storage (optional)
#
# When Redis credentials are present, the default-LLM daily counter is
# persisted in Upstash Redis (recommended for Vercel / any serverless deploy).
# When absent, the daily quota is simply not enforced.
#
# On Vercel: open the project → Storage → Marketplace → install a Redis
# integration (Upstash). Vercel will inject KV_REST_API_URL /
# KV_REST_API_TOKEN (and/or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
# automatically; no manual entry needed there.
# ─────────────────────────────────────────────────────────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative names (also accepted):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
